{
  "manifest_version": 3,
  "name": "Mivo",
  "version": "0.1.0",
  "description": "A calm, instant new tab.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["search"]
}
